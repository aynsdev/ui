{
  "$description": "Platform-agnostic tokens. Mirrors src/tokens.css — use for React Native, SwiftUI, Flutter, Figma, or Tailwind configs. Keep both in sync.",
  "color": {
    "light": {
      "bg": "#FAFAF8",
      "surface": "#FFFFFF",
      "surface2": "#F3F3F0",
      "surfaceHover": "#EEEEEA",
      "surfacePressed": "#E6E6E1",
      "text": "#181818",
      "textMuted": "#666762",
      "textSubtle": "#858681",
      "border": "#E5E5E1",
      "borderStrong": "#C9C9C3",
      "action": "#181818",
      "actionText": "#FFFFFF",
      "danger": "#B42318",
      "onDanger": "#FFFFFF",
      "success": "#19724B",
      "warning": "#946200",
      "focus": "#4F78C7"
    },
    "dark": {
      "bg": "#101113",
      "surface": "#17181B",
      "surface2": "#202125",
      "surfaceHover": "#2A2C30",
      "surfacePressed": "#32343A",
      "text": "#F5F5F3",
      "textMuted": "#ACADB0",
      "textSubtle": "#898C90",
      "border": "#313238",
      "borderStrong": "#505159",
      "action": "#F4F4F1",
      "actionText": "#17181B",
      "danger": "#F97066",
      "onDanger": "#17181B",
      "success": "#52C593",
      "warning": "#F5BC59",
      "focus": "#A5BEFF"
    }
  },
  "font": {
    "ui": "Geist",
    "mono": "Geist Mono",
    "fallback": ["Inter", "-apple-system", "BlinkMacSystemFont", "Segoe UI", "sans-serif"]
  },
  "type": {
    "display": { "size": 64, "weight": "600", "lineHeight": 1.02, "letterSpacing": -0.05 },
    "h1": { "size": 40, "weight": "600", "lineHeight": 1.1, "letterSpacing": -0.045 },
    "h2": { "size": 28, "weight": "600", "lineHeight": 1.18, "letterSpacing": -0.035 },
    "h3": { "size": 22, "weight": "600", "lineHeight": 1.24, "letterSpacing": -0.025 },
    "h4": { "size": 18, "weight": "600", "lineHeight": 1.35, "letterSpacing": -0.018 },
    "bodyLarge": { "size": 16, "weight": "400", "lineHeight": 1.6, "letterSpacing": -0.01 },
    "body": { "size": 14, "weight": "400", "lineHeight": 1.5, "letterSpacing": -0.005 },
    "ui": { "size": 13, "weight": "500", "lineHeight": 1.35, "letterSpacing": 0 },
    "caption": { "size": 12, "weight": "400", "lineHeight": 1.4, "letterSpacing": 0 },
    "micro": { "size": 11, "weight": "500", "lineHeight": 1.3, "letterSpacing": 0.01 }
  },
  "space": { "1": 4, "2": 8, "3": 12, "4": 16, "5": 20, "6": 24, "8": 32, "10": 40, "12": 48, "16": 64, "24": 96 },
  "radius": { "xs": 6, "sm": 8, "md": 10, "lg": 14, "xl": 18, "pill": 999 },
  "control": { "xs": 28, "sm": 32, "md": 38, "lg": 44, "xl": 48, "touchTarget": 44 },
  "motion": {
    "fast": 140,
    "base": 180,
    "slow": 240,
    "easeUi": [0.2, 0.8, 0.2, 1],
    "easeLayout": [0.4, 0, 0.2, 1]
  },
  "$notes": {
    "letterSpacing": "Expressed in em. Multiply by font size for platforms that use points/pixels (e.g. React Native: -0.035 * 28 = -0.98).",
    "typeSizes": "Display and h1 are fluid on web; values here are the mobile/native defaults."
  }
}
