{
  "$description": "Platform-agnostic tokens. Mirrors src/css/tokens.css — use for React Native, SwiftUI, Flutter, Figma, or Tailwind configs. Keep both in sync.",
  "color": {
    "light": {
      "bg": "#F5F5F5",
      "surface": "#FFFFFF",
      "surface2": "#EBEBEB",
      "surfaceHover": "#E5E5E5",
      "surfacePressed": "#DCDCDC",
      "text": "#171717",
      "textMuted": "#5C5C5C",
      "textSubtle": "#8A8A8A",
      "border": "#E8E8E8",
      "borderStrong": "#D1D1D1",
      "action": "#171717",
      "actionText": "#FAFAFA",
      "danger": "#B42318",
      "onDanger": "#FFFFFF",
      "success": "#19724B",
      "warning": "#946200",
      "focus": "#4F78C7"
    },
    "dark": {
      "bg": "#0A0A0A",
      "surface": "#161616",
      "surface2": "#1F1F1F",
      "surfaceHover": "#262626",
      "surfacePressed": "#303030",
      "text": "#FAFAFA",
      "textMuted": "#A1A1A1",
      "textSubtle": "#737373",
      "border": "#222222",
      "borderStrong": "#404040",
      "action": "#FAFAFA",
      "actionText": "#0A0A0A",
      "danger": "#F97066",
      "onDanger": "#0A0A0A",
      "success": "#52C593",
      "warning": "#F5BC59",
      "focus": "#A5BEFF"
    }
  },
  "font": {
    "ui": "Inter",
    "mono": "Geist Mono",
    "fallback": [
      "Geist",
      "-apple-system",
      "BlinkMacSystemFont",
      "Segoe UI",
      "sans-serif"
    ]
  },
  "type": {
    "display": {
      "size": 64,
      "weight": "700",
      "lineHeight": 1.02,
      "letterSpacing": -0.055
    },
    "h1": {
      "size": 40,
      "weight": "700",
      "lineHeight": 1.1,
      "letterSpacing": -0.045
    },
    "h2": {
      "size": 28,
      "weight": "600",
      "lineHeight": 1.18,
      "letterSpacing": -0.035
    },
    "h3": {
      "size": 22,
      "weight": "600",
      "lineHeight": 1.24,
      "letterSpacing": -0.025
    },
    "h4": {
      "size": 18,
      "weight": "600",
      "lineHeight": 1.35,
      "letterSpacing": -0.018
    },
    "bodyLarge": {
      "size": 16,
      "weight": "500",
      "lineHeight": 1.6,
      "letterSpacing": -0.011
    },
    "body": {
      "size": 14,
      "weight": "500",
      "lineHeight": 1.5,
      "letterSpacing": -0.011
    },
    "ui": {
      "size": 14,
      "weight": "500",
      "lineHeight": 1.35,
      "letterSpacing": 0
    },
    "caption": {
      "size": 12,
      "weight": "500",
      "lineHeight": 1.4,
      "letterSpacing": 0
    },
    "micro": {
      "size": 11,
      "weight": "500",
      "lineHeight": 1.3,
      "letterSpacing": 0.01
    }
  },
  "space": {
    "1": 4,
    "2": 8,
    "3": 12,
    "4": 16,
    "5": 20,
    "6": 24,
    "8": 32,
    "10": 40,
    "12": 48,
    "16": 64,
    "24": 96
  },
  "radius": {
    "xs": 8,
    "sm": 10,
    "md": 12,
    "lg": 16,
    "xl": 24,
    "pill": 999
  },
  "control": {
    "xs": 28,
    "sm": 32,
    "md": 40,
    "lg": 48,
    "xl": 56,
    "touchTarget": 44
  },
  "motion": {
    "fast": 140,
    "base": 180,
    "slow": 240,
    "easeUi": [
      0.2,
      0.8,
      0.2,
      1
    ],
    "easeLayout": [
      0.4,
      0,
      0.2,
      1
    ]
  },
  "$notes": {
    "letterSpacing": "Expressed in em. Multiply by font size for platforms that use points/pixels (e.g. React Native: -0.035 * 28 = -0.98).",
    "typeSizes": "Display and h1 are fluid on web; values here are the mobile/native defaults."
  }
}
