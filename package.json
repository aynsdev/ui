{
  "name": "@aynsdev/design-system",
  "version": "0.0.4",
  "description": "A refined, minimalist design system distributed as a shadcn registry, plus framework-agnostic CSS for non-React projects.",
  "license": "MIT",
  "type": "module",
  "style": "./dist/design-system.css",
  "exports": {
    "./styles.css": "./dist/design-system.css",
    "./styles.min.css": "./dist/design-system.min.css",
    "./css": "./src/css/index.css",
    "./tokens.css": "./src/css/tokens.css",
    "./base.css": "./src/css/base.css",
    "./typography.css": "./src/css/typography.css",
    "./layout.css": "./src/css/layout.css",
    "./fonts.css": "./src/css/fonts.css",
    "./tailwind.css": "./src/css/tailwind.css",
    "./components/*": "./src/css/components/*",
    "./ui.js": "./src/vanilla/ui.js",
    "./tokens.json": "./tokens/tokens.json",
    "./DESIGN.md": "./DESIGN.md",
    "./PROJECT_THEME.md": "./PROJECT_THEME.md",
    "./package.json": "./package.json"
  },
  "files": [
    "src/css",
    "src/vanilla",
    "dist",
    "tokens",
    "DESIGN.md",
    "PROJECT_THEME.md",
    "BRAND.md"
  ],
  "sideEffects": [
    "*.css",
    "./src/vanilla/ui.js",
    "./dist/ui.js"
  ],
  "scripts": {
    "dev": "vite",
    "build": "node scripts/build.mjs",
    "registry:build": "node scripts/build-registry.mjs",
    "build:docs": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prepare": "node scripts/build.mjs",
    "brand:build": "node scripts/build-brand-assets.mjs",
    "test:components": "node tests/components.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/aynsdev/ui.git"
  },
  "devDependencies": {
    "@internationalized/date": "^3.12.4",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.62.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-aria-components": "^1.22.1",
    "react-dom": "^19.3.1",
    "shadcn": "^4.23.0",
    "sharp": "^0.35.5",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
